alias python='python3.14'
alias reload='. ~/.bashrc'
alias scan-dir="du -h . | sort -h"
alias scan-fs="sudo du -h --max-depth=1 / | sort -h"
alias domains='cat /etc/hosts'
alias lab='start-core;cd $LAB'
alias start-core='source $LAB/.core/bin/activate'
alias stop-core='deactivate'
alias update-dep='start-core;cd $LAB;uv sync --active'
alias create-env='uv venv .core'
